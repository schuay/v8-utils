#!/usr/bin/env vpython3
# Launcher for the `v8-mcp` MCP server under vpython3.

import os
import sys

_SCRIPT = os.path.realpath(__file__)
_REPO_ROOT = os.path.dirname(os.path.dirname(_SCRIPT))
sys.path.insert(0, os.path.join(_REPO_ROOT, "src"))

from v8_utils.server import mcp

if __name__ == "__main__":
    mcp.run()
