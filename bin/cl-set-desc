#!/usr/bin/env python3
# Launcher for `cl-set-desc`. Stdlib only, so it runs without the venv.

import os
import sys

_SCRIPT = os.path.realpath(__file__)
_REPO_ROOT = os.path.dirname(os.path.dirname(_SCRIPT))
sys.path.insert(0, os.path.join(_REPO_ROOT, "src"))

from v8_utils.cli.cl_desc import main

if __name__ == "__main__":
    sys.exit(main())
